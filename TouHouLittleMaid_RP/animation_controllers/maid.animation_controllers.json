{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.touhou_little_maid.sitting" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"sitting" : "!q.is_in_ui && v.tlm_is_sitting"
						},
						{
							"hug": "!q.is_in_ui && v.tlm_is_hug"
						}
					],
					"blend_transition": 0.375
				},

				"sitting" : {
					"animations" : [ "sit" ],
					"transitions" : [
						{
							"default" : "!v.tlm_is_sitting || q.is_in_ui"
						},
						{
							"hug": "!q.is_in_ui && v.tlm_is_hug"
						}
					],
					"blend_transition": 0.375
				},
				"hug": {
					"animations": [ "hug" ],
					"transitions" : [
						{
							"default" : "!v.tlm_is_hug || q.is_in_ui"
						}
					],
					"blend_transition": 0.375
				}
			}
		}
	}
}
